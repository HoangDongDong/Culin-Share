{
  "redirects": [
    { "source": "/category/vifoodrec", "destination": "/search", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "culin-share.vercel.app" }],
      "destination": "https://bepnhaminh.page/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://culin-share-backend.vercel.app/api/seo/sitemap.xml" },
    { "source": "/(.*)", "destination": "/spa.html" }
  ]
}
